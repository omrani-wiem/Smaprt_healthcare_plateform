<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:tns="http://healthcare.com/soap/cnam"
           targetNamespace="http://healthcare.com/soap/cnam"
           elementFormDefault="qualified">

    <xs:element name="verifierDroitsCNAMRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="patientId" type="xs:long"/>
                <xs:element name="numeroCNAM" type="xs:string"/>
                <xs:element name="codeActe" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="verifierDroitsCNAMResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="droitsOuverts" type="xs:boolean"/>
                <xs:element name="tauxRemboursement" type="xs:int"/>
                <xs:element name="motif" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>


    <xs:element name="emettreFeuilleDeSoinsRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="patientId" type="xs:long"/>
                <xs:element name="numeroCNAM" type="xs:string"/>
                <xs:element name="codeActe" type="xs:string"/>
                <xs:element name="montant" type="xs:decimal"/>
                <xs:element name="dateActe" type="xs:date"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>


     <xs:element name="emettreFeuilleDeSoinsResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="numeroFeuille" type="xs:string"/>
                <xs:element name="montantRembourse" type="xs:decimal"/>
                <xs:element name="resteACharge" type="xs:decimal"/>
                <xs:element name="statut" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>


     <xs:element name="consulterHistoriqueRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="patientId" type="xs:long"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="consulterHistoriqueResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="acte" type="tns:acte" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:complexType name="acte">
        <xs:sequence>
            <xs:element name="numeroFeuille" type="xs:string"/>
            <xs:element name="codeActe" type="xs:string"/>
            <xs:element name="dateActe" type="xs:date"/>
            <xs:element name="montant" type="xs:decimal"/>
            <xs:element name="montantRembourse" type="xs:decimal"/>
        </xs:sequence>
    </xs:complexType>
</xs:schema>




