{
  "title": "Smart Healthcare - Vue d'ensemble",
  "uid": "healthcare-overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    { "id": 1, "type": "stat", "title": "Cibles UP",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [ { "refId": "A", "expr": "count(up == 1)" } ],
      "fieldConfig": { "defaults": {}, "overrides": [] } },

    { "id": 2, "type": "stat", "title": "Alertes critiques (5 min)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [ { "refId": "A", "expr": "sum(increase(healthcare_alerts_total[5m]))" } ],
      "fieldConfig": { "defaults": { "decimals": 0 }, "overrides": [] } },

    { "id": 3, "type": "stat", "title": "Interventions (1 h)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [ { "refId": "A", "expr": "sum(increase(healthcare_interventions_total[1h]))" } ],
      "fieldConfig": { "defaults": { "decimals": 0 }, "overrides": [] } },

    { "id": 4, "type": "stat", "title": "Durée moyenne de prise en charge",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [ { "refId": "A", "expr": "sum(increase(healthcare_workflow_duration_seconds_sum[1h])) / sum(increase(healthcare_workflow_duration_seconds_count[1h]))" } ],
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 2 }, "overrides": [] } },

    { "id": 5, "type": "timeseries", "title": "Requêtes par seconde",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [ { "refId": "A", "expr": "sum by (application) (rate(http_server_requests_seconds_count[1m]))", "legendFormat": "{{application}}" } ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] } },

    { "id": 6, "type": "timeseries", "title": "Latence p95",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [ { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, application) (rate(http_server_requests_seconds_bucket[1m])))", "legendFormat": "{{application}}" } ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] } },

    { "id": 7, "type": "timeseries", "title": "Erreurs 5xx par seconde",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [ { "refId": "A", "expr": "sum by (application) (rate(http_server_requests_seconds_count{status=~\"5..\"}[1m]))", "legendFormat": "{{application}}" } ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] } },

    { "id": 8, "type": "timeseries", "title": "Circuit breakers (1 = ouvert)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [ { "refId": "A", "expr": "resilience4j_circuitbreaker_state{state=\"open\"}", "legendFormat": "{{name}}" } ],
      "fieldConfig": { "defaults": { "min": 0, "max": 1 }, "overrides": [] } },

    { "id": 9, "type": "timeseries", "title": "Alertes par type (par minute)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [ { "refId": "A", "expr": "sum by (type) (increase(healthcare_alerts_total[1m]))", "legendFormat": "{{type}}" } ],
      "fieldConfig": { "defaults": {}, "overrides": [] } },

    { "id": 10, "type": "timeseries", "title": "Mémoire heap JVM",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [ { "refId": "A", "expr": "sum by (application) (jvm_memory_used_bytes{area=\"heap\"})", "legendFormat": "{{application}}" } ],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] } }
  ]
}